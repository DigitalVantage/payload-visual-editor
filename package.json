{
  "name": "payload-visual-editor-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "clean": "pnpm --filter \"./packages/*\" -r clean",
    "dev": "pnpm build && pnpm --filter dev dev",
    "watch": "pnpm --filter \"./packages/*\" --parallel -r watch",
    "test": "pnpm --filter @digitalvantage/payload-visual-editor-tests test",
    "e2e": "pnpm build && pnpm --filter @digitalvantage/payload-visual-editor-tests e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
