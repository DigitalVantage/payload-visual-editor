{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "int",
    "e2e",
    "consumer",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.consumer.config.ts",
    "fixtures.ts"
  ]
}
